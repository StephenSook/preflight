# Preflight, environment template. NEVER commit the real .env.

# --- Vonage (the application whose webhooks point at Preflight) ---
VONAGE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# PEM of the application's PUBLIC key (you generated the pair). The create-call gateway verifies callers with it.
VONAGE_APPLICATION_PUBLIC_KEY_PATH=./secrets/public.key
# The same PEM inline for hosts without a file for it (wins over the path; backslash-n line breaks accepted).
# VONAGE_APPLICATION_PUBLIC_KEY_PEM=
# The private half. The operator scripts sign with it, and the server mints its own tokens with it for
# Verify v2 and the demonstration call (the consent gate is off without it). Inline PEM wins over the path.
VONAGE_PRIVATE_KEY_PATH=./secrets/private.key
# VONAGE_PRIVATE_KEY_PEM=
# The operator scripts under scripts/vonage and the GitHub workflows read the inline PEM as VONAGE_PRIVATE_KEY
# (a secret on the runner); on a person's machine they fall back to VONAGE_PRIVATE_KEY_PATH.
# VONAGE_PRIVATE_KEY=
# The account number the demonstration call is placed from (digits, no plus).
VONAGE_FROM_NUMBER=
# A checked consent covers one demonstration call for this long; the daily allowances bound what a public page can spend.
CONSENT_TTL_MINUTES=15
VERIFY_STARTS_PER_DAY=40
DEMO_CALLS_PER_DAY=20
# Identity Insights (Number Insight's successor): a paid lookup that resolves a hold the free prefix tables could not
# (timezone unknown or split) and gives a high-confidence line type. Runs AFTER a hold, never inside a decision;
# cached per line; bounded per day. Needs the application private key. Off by default because each lookup costs money.
IDENTITY_INSIGHTS=off
IDENTITY_INSIGHTS_HOST=https://api-eu.vonage.com
INSIGHTS_PER_DAY=20
VONAGE_API_KEY=
# Read only by the operator scripts that call the Application API (repointing webhooks). Not by the server.
VONAGE_API_SECRET=
# Signature secret from Dashboard > Settings > Signed webhooks. Used to verify every inbound webhook JWT.
VONAGE_SIGNATURE_SECRET=
VONAGE_API_HOST=https://api.nexmo.com

# --- Preflight ---
# Public base URL of THIS API server (Render URL in production, cloudflared quick tunnel in dev). No trailing slash.
PUBLIC_BASE_URL=https://example.onrender.com
# The developer's real answer URL that Preflight forwards to (the reference app in the demo).
ORIGIN_ANSWER_URL=https://example.onrender.com/reference/answer
# Optional separate origin for event webhooks; defaults to ORIGIN_ANSWER_URL with /event.
# ORIGIN_EVENT_URL=
# Budget for the origin round trip inside Vonage's 5 s answer window (ms, max 4500). Fails closed past it.
ORIGIN_TIMEOUT_MS=3000
# strict = hold on inconclusive; advisory = pass with warning
POLICY_MODE=strict
PORT=3131
LOG_LEVEL=info
# On a free host that sleeps when idle, the process fetches its own /health every four minutes (https PUBLIC_BASE_URL only).
SELF_PING=on

# --- Storage ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Evidence anchoring ---
# The ledger signing key is NOT an environment variable: the daily seal workflow reads it from the GitHub
# Actions secret LEDGER_SIGNING_KEY (ECDSA P-256 PEM) and the public half is committed under packages/ledger/keys.

# --- Number facts ---
# The free tables (NANPA central office codes, the timezone map) are committed under packages/numfacts/data.
# The paid lookup is configured above (IDENTITY_INSIGHTS, IDENTITY_INSIGHTS_HOST, INSIGHTS_PER_DAY); the
# operator script scripts/vonage/identity-insights.mjs reads the same host variable.

# What the developer declares about their flow (Setup screen; JSON). Without it no talk identifies
# and no input offers opt-out, which is the fail-closed default.
# FLOW_DECLARATION_JSON={"identification":{"phrases":["This is a message from Example Clinic"]},"optOut":{"eventUrlPatterns":["/webhooks/optout"]}}

# Shared secret the daily seal workflow presents when it records a Rekor anchor (16+ chars).
# Absent disables POST /api/ledger/seals.
# SEAL_TOKEN=

# The reference application (the deliberately non-compliant demo flow) mounted under /reference on this host.
# With REFERENCE_APP=on, point ORIGIN_ANSWER_URL at http://127.0.0.1:3131/reference/answer.
REFERENCE_APP=off
REFERENCE_MODE=broken
# REFERENCE_ADMIN_TOKEN=
REFERENCE_AGENT=scheduler

# Bearer token for the dashboard's write actions (deciding a held call). 16+ chars. Absent disables them.
# DASHBOARD_TOKEN=

# The browser softphone (Client SDK): judge tokens are public and capped per day; the scheduler's needs the dashboard
# token. The application must carry the RTC capability (scripts/vonage/enable-rtc.mjs) and the private key must be set.
SOFTPHONE_TOKENS_PER_DAY=50
SOFTPHONE_TOKEN_TTL_MINUTES=30

# Where the web app lives (the dedicated Vercel project), for the links notifications carry. The API host when absent.
# PUBLIC_WEB_URL=

# Web Push for the held queue (a hold needs a person; the person holds a phone). All three present turns it on.
# Generate once: `pnpm --filter @preflight/api exec web-push generate-vapid-keys`. The private key is a secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# How many phones may subscribe (a broadcast walks every row).
PUSH_SUBSCRIPTIONS_MAX=50
