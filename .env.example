# Preflight, environment template. NEVER commit the real .env.

# --- Vonage (the application whose webhooks point at Preflight) ---
VONAGE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Signature secret from Dashboard > Settings > Signed webhooks. Used to verify every inbound webhook JWT.
VONAGE_SIGNATURE_SECRET=
VONAGE_API_HOST=https://api.nexmo.com

# --- Preflight ---
# Public base URL of THIS API server (Render URL in production, cloudflared quick tunnel in dev). No trailing slash.
PUBLIC_BASE_URL=https://example.onrender.com
# The developer's real answer URL that Preflight forwards to (the reference app in the demo).
ORIGIN_ANSWER_URL=https://example.onrender.com/reference/answer
# strict = hold on inconclusive; advisory = pass with warning
POLICY_MODE=strict
PORT=3131

# --- Storage ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Evidence anchoring (ECDSA P-256 PEM, generated with openssl; never commit) ---
LEDGER_SIGNING_KEY_PATH=./ledger-signing.key
REKOR_URL=https://rekor.sigstore.dev

# --- Number facts ---
IDENTITY_INSIGHTS_HOST=https://api-eu.vonage.com
NANPA_CO_CODE_URL=https://reports.nanpa.com/public/CoCodeAssignment_Utilized_AllStates_Public.zip

# What the developer declares about their flow (Setup screen; JSON). Without it no talk identifies
# and no input offers opt-out, which is the fail-closed default.
# FLOW_DECLARATION_JSON={"identification":{"phrases":["This is a message from Example Clinic"]},"optOut":{"eventUrlPatterns":["/webhooks/optout"]}}

# Shared secret the daily seal workflow presents when it records a Rekor anchor (16+ chars).
# Absent disables POST /api/ledger/seals.
# SEAL_TOKEN=
