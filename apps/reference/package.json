{
  "name": "@preflight/reference",
  "version": "0.1.0",
  "private": true,
  "description": "The deliberately non-compliant reference application behind the public number, so anyone can dial it and hear the interlock intervene.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx --conditions=development watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.12.0"
  },
  "devDependencies": {}
}
