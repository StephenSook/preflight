{
  "name": "a pay action alone, with prompts: the platform speaks them",
  "description": "The pay action's prompts (and their error prompts) are read aloud by the platform's text-to-speech, so a pay with prompts speaks synthetically like a talk. Nothing identifies the caller before it, so P2 and P5 are false at pay#0. P3 holds vacuously: no identification beat means no obligation is triggered. A pay with no prompts is silent to the atoms.",
  "declaration": {
    "identification": {
      "phrases": [
        "This is a message from Preflight Demo Clinic"
      ]
    },
    "optOut": {
      "eventUrlPatterns": [
        "/webhooks/optout"
      ]
    }
  },
  "ncco": [
    {
      "action": "pay",
      "amount": 12.5,
      "currency": "usd",
      "eventUrl": [
        "https://origin.example/webhooks/pay"
      ],
      "prompts": [
        {
          "type": "CardNumber",
          "text": "Please enter your card number.",
          "errors": {
            "InvalidCardNumber": {
              "text": "That number is not valid."
            }
          }
        },
        {
          "type": "ExpirationDate",
          "text": "Enter the expiry date."
        }
      ],
      "voice": {
        "language": "en-US",
        "style": 0
      }
    }
  ],
  "expect": {
    "kinds": [
      "pay"
    ],
    "atoms": [
      {
        "speaks": true,
        "synthetic": true,
        "identifies": false,
        "offers_optout": false,
        "connects_human": false
      }
    ],
    "errors": 0,
    "terminal": {
      "facts": {
        "from": "14045550100",
        "lineType": "wireless",
        "withinHours": true
      },
      "verdicts": {
        "P1": "true",
        "P2": "false",
        "P3": "true",
        "P4": "true",
        "P5": "false"
      },
      "decision": "block",
      "witness": {
        "P2": {
          "path": [
            "pay#0"
          ],
          "atEnd": false
        },
        "P5": {
          "path": [
            "pay#0"
          ],
          "atEnd": false
        }
      }
    }
  }
}
