        "/webhooks/optout"
      ]
    }
  },
  "ncco": [
    {
      "action": "stream",
      "streamUrl": [
        "https://origin.example/audio/jingle.mp3"
      ]
    },
    {
      "action": "talk",
      "text": "This is a message from Preflight Demo Clinic."
    },
    {
      "action": "input",
      "type": [
        "dtmf"
      ],
