{
  "name": "the opt-out input runs before the identification beat",
  "description": "An opt-out that precedes the identification does not discharge it: F looks forward from the identification beat. P2 and P5 are undecided through the silent input and decided true at the talk; P3 is false when the flow ends with the identification unanswered.",
  "declaration": {
    "identification": {
      "phrases": [
        "This is a message from Preflight Demo Clinic"
      ]
    },
    "optOut": {
      "eventUrlPatterns": [
        "/webhooks/optout"
      ]
    }
  },
  "ncco": [
    {
      "action": "input",
      "type": [
        "dtmf"
      ],
      "dtmf": {
        "maxDigits": 1,
        "timeOut": 5
      },
      "eventUrl": [
        "https://origin.example/webhooks/optout"
      ],
      "eventMethod": "POST"
    },
    {
      "action": "talk",
      "text": "This is a message from Preflight Demo Clinic."
    }
  ],
  "expect": {
    "kinds": [
      "input",
      "talk"
    ],
    "atoms": [
      {
        "speaks": false,
        "synthetic": false,
        "identifies": false,
        "offers_optout": true,
        "connects_human": false
      },
      {
        "speaks": true,
        "synthetic": true,
        "identifies": true,
        "offers_optout": false,
        "connects_human": false
      }
    ],
    "errors": 0,
    "terminal": {
      "facts": {
        "from": "14045550100",
        "lineType": "wireless",
        "withinHours": true
      },
      "verdicts": {
        "P1": "true",
        "P2": "true",
        "P3": "false",
        "P4": "true",
        "P5": "true"
      },
      "decision": "block",
      "witness": {
        "P3": {
          "path": [
            "input#0",
            "talk#1"
          ],
          "atEnd": true
        }
      }
    }
  }
}
