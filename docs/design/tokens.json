{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Preflight design tokens, two palette options for the 2026-09-05 checkpoint. The verdict triad and the dashboard set are fixed by the product specification; the site set is the open decision.",
  "verdict": {
    "blocked": { "$type": "color", "$value": "#E5484D", "$description": "The call was stopped. Used for nothing else." },
    "held": { "$type": "color", "$value": "#F5A524", "$description": "Held for a human decision. Used for nothing else." },
    "passed": { "$type": "color", "$value": "#30A46C", "$description": "Placed. Used for nothing else." }
  },
  "dashboard": {
    "canvas": { "$type": "color", "$value": "#0B0D0F" },
    "surface": { "$type": "color", "$value": "#14181C" },
    "text": { "$type": "color", "$value": "#E8EDF2" },
    "textMuted": { "$type": "color", "$value": "#8B98A5" },
    "interactive": { "$type": "color", "$value": "#4C8DFF" },
    "grid": { "$type": "dimension", "$value": "4px" },
    "fontBody": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "fontMono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] },
    "sizeBody": { "$type": "dimension", "$value": "13px" },
    "sizeMono": { "$type": "dimension", "$value": "12px" }
  },
  "site": {
    "optionA": {
      "$description": "Preflight as in aviation: paper, sky, cobalt, safety orange. Recommended.",
      "paper": { "$type": "color", "$value": "#FFF4D6" },
      "paperDeep": { "$type": "color", "$value": "#FFE9B8" },
      "sky": { "$type": "color", "$value": "#A4E4FF" },
      "skyPale": { "$type": "color", "$value": "#DDF4FF" },
      "cobalt": { "$type": "color", "$value": "#1F4BFF" },
      "cobaltDeep": { "$type": "color", "$value": "#132FA6" },
      "safetyOrange": { "$type": "color", "$value": "#FF7A1A" },
      "ink": { "$type": "color", "$value": "#0B0D0F" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "annotation": { "$type": "color", "$value": "#1F4BFF", "$description": "Handwritten notes, at 0.8 opacity, rotated 4 degrees." }
    },
    "optionB": {
      "$description": "The reference's own brightness: yellow, pink, cyan, periwinkle.",
      "yellow": { "$type": "color", "$value": "#FFD24A" },
      "yellowPale": { "$type": "color", "$value": "#FAED8F" },
      "orange": { "$type": "color", "$value": "#F9A220" },
      "pink": { "$type": "color", "$value": "#FD48F2" },
      "pinkSoft": { "$type": "color", "$value": "#FFDBFD" },
      "cyan": { "$type": "color", "$value": "#1CE8ED" },
      "bluePale": { "$type": "color", "$value": "#A4F6F8" },
      "periwinkle": { "$type": "color", "$value": "#9982DE" },
      "violet": { "$type": "color", "$value": "#3B308F" },
      "ink": { "$type": "color", "$value": "#000000" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    }
  },
  "type": {
    "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Arial Black", "sans-serif"], "$description": "Weight 800, tracking -0.02em, line-height 0.85. In place of Champ." },
    "body": { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "sans-serif"], "$description": "Weights 500 to 700. In place of Degular." },
    "hand": { "$type": "fontFamily", "$value": ["Caveat", "cursive"], "$description": "Annotations only." },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Verdicts, citations, every number." },
    "scale": {
      "root": { "$type": "dimension", "$value": "12px", "$description": "Root size; everything else in em so the page scales with the viewport, as the reference does." },
      "headingXxl": { "$type": "dimension", "$value": "10em" },
      "headingL": { "$type": "dimension", "$value": "6.5em" },
      "headingM": { "$type": "dimension", "$value": "5em" },
      "headingS": { "$type": "dimension", "$value": "2.5em" },
      "paragraphLarge": { "$type": "dimension", "$value": "2em" },
      "paragraphRegular": { "$type": "dimension", "$value": "1.5em" },
      "paragraphSmall": { "$type": "dimension", "$value": "1.25em" },
      "handwrittenRegular": { "$type": "dimension", "$value": "2em" }
    }
  },
  "motion": {
    "easeDefault": { "$type": "cubicBezier", "$value": [0.625, 0.05, 0, 1], "$description": "The reference's default; every tween that does not name an ease." },
    "easeEnergy": { "$type": "string", "$value": "M0,0 C0.32,0.72 0,1 1,1", "$description": "SVG path ease for fades and slides." },
    "easePop": { "$type": "string", "$value": "elastic.out(1, 0.72)" },
    "easeStamp": { "$type": "string", "$value": "elastic.out(1, 0.75)" },
    "easeReveal": { "$type": "string", "$value": "circ.out" },
    "durationDefault": { "$type": "duration", "$value": "600ms" },
    "staggerDefault": { "$type": "duration", "$value": "50ms" },
    "staggerWords": { "$type": "duration", "$value": "88ms" },
    "staggerChars": { "$type": "duration", "$value": "16ms" },
    "introTotal": { "$type": "duration", "$value": "1900ms", "$description": "Load layer plus hero reveal, matching the reference." },
    "reducedMotion": { "$type": "string", "$value": "instant", "$description": "Every module has a reduced-motion branch that sets the final state with no tween." }
  },
  "layout": {
    "columns": { "$type": "number", "$value": 12 },
    "margin": { "$type": "dimension", "$value": "1.5em" },
    "headerHeight": { "$type": "dimension", "$value": "6.625em" },
    "sectionRadius": { "$type": "dimension", "$value": "3em", "$description": "Full-bleed colour blocks with large rounded corners." },
    "buttonRadius": { "$type": "dimension", "$value": "999px" }
  }
}
