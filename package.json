{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Preflight: a pre-dial compliance interlock for the Vonage Voice API. It reads the call flow your own server is about to serve and stops the call before the carrier sees it if that flow would break federal or Georgia telemarketing law.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "mutate": "node scripts/mutation/run.mjs",
    "verify:engine": "vitest run packages/engine --reporter=verbose",
    "ledger:verify": "tsx --conditions=development packages/cli/src/cli.ts verify-ledger",
    "replay": "tsx --conditions=development packages/cli/src/cli.ts replay",
    "dev:api": "pnpm --filter @preflight/api run dev",
    "dev:web": "pnpm --filter @preflight/web run dev",
    "gate:tone": "bash scripts/ai-tone-gate.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
