{
  "name": "@preflight/cli",
  "version": "0.1.0",
  "private": true,
  "description": "npx preflight: replay the released webhook corpus offline, verify a ledger, check a single NCCO.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "replay": "tsx src/index.ts replay"
  },
  "dependencies": {
    "@preflight/engine": "workspace:*",
    "@preflight/ledger": "workspace:*",
    "@preflight/rules": "workspace:*"},
  "devDependencies": {}
}
