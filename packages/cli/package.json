{
  "name": "preflight-interlock",
  "version": "0.2.0",
  "private": false,
  "description": "npx preflight: check a Vonage call-control object against the federal and Georgia telemarketing rules, replay the labelled corpus, verify a Preflight evidence log. No account, no data tables.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/preflight.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --conditions=development --outfile=dist/preflight.js --banner:js=\"#!/usr/bin/env node\" --log-level=warning && chmod +x dist/preflight.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "replay": "tsx --conditions=development src/cli.ts replay",
    "check": "tsx --conditions=development src/cli.ts check",
    "verify-ledger": "tsx --conditions=development src/cli.ts verify-ledger"
  },
  "dependencies": {},
  "devDependencies": {
    "@preflight/engine": "workspace:*",
    "@preflight/ledger": "workspace:*"
  },
  "bin": {
    "preflight": "dist/preflight.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenSook/preflight.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/StephenSook/preflight#readme",
  "keywords": [
    "vonage",
    "voice-api",
    "tcpa",
    "compliance",
    "ncco",
    "runtime-verification",
    "ltl3"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
