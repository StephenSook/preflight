{
  "name": "@preflight/rules",
  "version": "0.1.0",
  "private": true,
  "description": "The Preflight property set: citations, eCFR text fetched at build, ruleset digest, and the coverage file that ties every quoted clause to a live code path.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data/47-cfr-64.1200.txt",
    "data/ocga-46-5-27.txt",
    "data/ga-comp-r-regs-515-14-1-03.txt",
    "data/ga-sb73-2024-signed.txt",
    "data/SOURCES.json",
    "data/citations.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fetch": "node ../../scripts/fetch-rules.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@preflight/engine": "workspace:*"
  }
}
